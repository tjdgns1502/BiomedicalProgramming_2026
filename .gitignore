# This folder doubles as the local R runtime install - not part of the project
/bin/
/library/
/Tcl/
/share/
/src/
/include/
/etc/
/modules/
/doc/
/tests/
/CHANGES
/COPYING
/MD5
/README
/README.R-4.6.1
/unins000.*

# Raw downloaded datasets and derived binaries (regenerate via each week's download script)
# applies to every week's data/ folder, e.g. 2nd_weeks/data/
**/data/*.XPT
**/data/*.rds
**/data/*.csv
!**/data/table1_comparison.csv
!**/data/table1_reproduced.csv
!**/data/flowchart_check.csv
!**/data/download_summary.csv
!**/data/distribution_diagnostics.csv
**/data/raw/

# Claude Code local tooling config (not project content)
/.claude/
